# Copy to .env in this folder and fill in your values:
#   cp .env.example .env
# Only needed for live mode. .env is gitignored; never commit it.

# App Key and App Secret from your app on developer.schwab.com
SCHWAB_API_KEY=your-app-key
SCHWAB_APP_SECRET=your-app-secret

# Must match the callback URL registered on the app character-for-character,
# including the trailing slash.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/

# Your brokerage account id (digits)
SCHWAB_ACCOUNT_ID=00000000

# Absolute path; the token is written here and reused across runs
SCHWAB_TOKEN_PATH=/abs/path/to/token.json

# Optional: default symbol when --symbol is not given
SCHWAB_SYMBOL=GOOG

# Optional: comma-separated watchlist when --watchlist is not given
SCHWAB_WATCHLIST=AAPL,GOOG,TSLA,NVDA
